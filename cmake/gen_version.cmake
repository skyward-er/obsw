find_package(Git QUIET)


# OBSW :
set(OBSW_COMMIT "00000000")
execute_process(
    COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
    WORKING_DIRECTORY ${OBSW_DIR}
    OUTPUT_VARIABLE OBSW_FULL_HASH
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE OBSW_RESULT
    ERROR_QUIET
)
if(OBSW_RESULT EQUAL 0)
    string(SUBSTRING "${OBSW_FULL_HASH}" 0 8 OBSW_COMMIT)
else()
    message(WARNING "gen_version: did NOT read OBSW COMMIT, using 00...00")
endif()



